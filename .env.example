OPENSEARCH_PASSWORD=admin

# --- AI overview (optional) -------------------------------------------------
# The overview feature is off unless LLM_API_KEY is set; the app then reports
# "no model configured" and serves search normally. Copy this file to `.env`
# at the repo root -- api/main.py loads it via python-dotenv at startup.
#
# Never commit a real key. `.env` is untracked; `.env.example` is not a secret.
#
# Any provider exposing OpenAI-compatible /v1/chat/completions works.
# Groq, for example:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional tuning. Out-of-range values are clamped and unparseable ones are
# ignored with a warning, so a typo here cannot take the API down.
# LLM_TIMEOUT=30
#
# Word-overlap floor for keeping a cited claim, and the longest verbatim run
# allowed from a source. 0.34 was calibrated only against EXTRACTIVE claims;
# re-measure against a live model with
#   python evaluation/remeasure_support_threshold.py
# before trusting it. See api/overview.py for the measured noise ceiling.
# LLM_SUPPORT_MIN=0.34
# LLM_VERBATIM_MAX_RUN=15
